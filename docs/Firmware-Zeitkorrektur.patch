+/* Atomic 32-bit timer snapshot on the 8-bit AVR. */
+uint32_t sys_time_read(void)
+{
+    uint32_t value;
+    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) { value = sys_time; }
+    return value;
+}
